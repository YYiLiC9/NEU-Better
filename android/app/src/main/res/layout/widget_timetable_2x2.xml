<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/widget_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="今日 / 周一"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#14243B" />

            <TextView
                android:id="@+id/widget_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#5D7392" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="56dp">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="#5D7392"
                android:text="" />

            <LinearLayout
                android:id="@+id/widget_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/widget_item1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:background="@drawable/widget_row_bg">

                    <TextView
                        android:id="@+id/widget_item1_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="9.5sp"
                        android:textColor="#5D7392"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/widget_item1_bar"
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:background="#0B4F9C" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_item1_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#14243B"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_item1_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="9.5sp"
                            android:textColor="#5D7392"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:paddingTop="2dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_item2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:minHeight="34dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="7dp"
                    android:background="@drawable/widget_row_bg">

                    <TextView
                        android:id="@+id/widget_item2_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="9.5sp"
                        android:textColor="#5D7392"
                        android:maxLines="2" />

                    <TextView
                        android:id="@+id/widget_item2_bar"
                        android:layout_width="4dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="8dp"
                        android:background="#0B4F9C" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_item2_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#14243B"
                            android:maxLines="2"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/widget_item2_info"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="9.5sp"
                            android:textColor="#5D7392"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:paddingTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
